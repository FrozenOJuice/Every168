NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://hours:hours_local_only@localhost:54320/hours_dev
# Run db:provision after the first migration to switch DATABASE_URL to hours_app.
# Migrations retain the admin URL separately; never use it for the production API.
# MIGRATION_DATABASE_URL=postgresql://hours:hours_local_only@localhost:54320/hours_dev
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info
# Forwarded IPs are ignored by default. Only list proxy IPs/CIDRs when the edge
# overwrites client-supplied forwarding headers. Do not trust Next.js alone.
TRUSTED_PROXY_CIDRS=
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=3000
DB_STATEMENT_TIMEOUT_MS=5000
DB_LOCK_TIMEOUT_MS=2000
DB_IDLE_TRANSACTION_TIMEOUT_MS=10000
DB_QUERY_TIMEOUT_MS=7000
SHUTDOWN_TIMEOUT_MS=10000
API_RATE_LIMIT=600
TEST_DATABASE_URL=postgresql://hours:hours_test_only@localhost:54321/hours_test
