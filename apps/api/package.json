{
  "name": "@168hours/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/infrastructure/database/migrate.ts",
    "db:seed": "tsx src/infrastructure/database/seed.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:provision": "tsx src/infrastructure/database/provision-local.ts"
  },
  "dependencies": {
    "@168hours/contracts": "workspace:*",
    "@168hours/domain-utils": "workspace:*",
    "better-auth": "1.7.4",
    "better-call": "1.4.0",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "drizzle-kit": "0.31.10",
    "supertest": "7.2.2"
  }
}
