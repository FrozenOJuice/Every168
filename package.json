{
  "name": "168hours",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.12"
  },
  "pnpm": {
    "overrides": {
      "@esbuild-kit/core-utils>esbuild": "0.25.12",
      "body-parser": "2.4.0",
      "ip-address": "10.7.4",
      "source-map-js": "1.2.2",
      "qs": "6.16.1",
      "vite": "8.3.3",
      "brace-expansion@<2": "1.1.21",
      "brace-expansion@^5": "5.0.12",
      "esbuild@>=0.27.3 <0.28.1": "0.28.2"
    }
  },
  "scripts": {
    "db:up": "docker compose -f infra/compose.yaml up -d --wait",
    "db:down": "docker compose -f infra/compose.yaml down",
    "db:generate": "pnpm --filter @168hours/api db:generate",
    "db:migrate": "pnpm --filter @168hours/api db:migrate",
    "db:seed": "pnpm --filter @168hours/api db:seed",
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "dev:api": "pnpm --filter @168hours/api dev",
    "dev:web": "pnpm --filter @168hours/web dev",
    "lint": "eslint . --max-warnings=0 && node scripts/check-boundaries.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run --config vitest.config.ts && node --test scripts/boundaries.test.mjs",
    "test:integration": "pnpm --filter @168hours/api test:integration",
    "test:e2e": "playwright test",
    "test:e2e:release": "playwright test --config playwright.release.config.ts",
    "build": "pnpm -r build",
    "verify": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm test:integration && pnpm build && pnpm test:e2e",
    "setup:env": "node scripts/setup-env.mjs",
    "db:provision": "pnpm --filter @168hours/api db:provision",
    "admin:create": "pnpm --filter @168hours/api admin:create",
    "test:e2e:beta": "playwright test --config playwright.beta.config.ts",
    "test:e2e:production": "playwright test --config playwright.production.config.ts",
    "verify:beta": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm test:integration && pnpm audit --prod && RELEASE_SCOPE=core pnpm build && pnpm test:e2e:beta",
    "brand:assets": "node scripts/brand-assets.mjs",
    "portfolio:capture": "playwright test --config playwright.portfolio.config.ts",
    "portfolio:social": "node scripts/social-preview.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "tsup": "8.5.1",
    "tsx": "4.23.13",
    "typescript": "6.0.2",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  },
  "license": "MIT"
}
